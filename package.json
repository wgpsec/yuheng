{
  "name": "yuheng",
  "version": "0.3.9",
  "private": true,
  "description": "Yuheng desktop personal secretary",
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.yuheng.desktop",
    "productName": "玉衡",
    "artifactName": "玉衡-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "electron/prompts/**/*",
      "electron/skills/**/*",
      "assets/yuheng-tray.png",
      "package.json",
      "!node_modules/@injaneity/pi-computer-use/prebuilt/linux/**",
      "!node_modules/@injaneity/pi-computer-use/prebuilt/macos/x64/**"
    ],
    "publish": null,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/yuheng-icon.icns",
      "minimumSystemVersion": "13.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/yuheng-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "postinstall": "node scripts/patch-pi-computer-use.mjs",
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1 --port ${VITE_PORT:-5173} --strictPort\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://127.0.0.1:${VITE_PORT:-5173} && ELECTRON_RENDERER_URL=http://127.0.0.1:${VITE_PORT:-5173} electron dist-electron/main.js\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run check:computer-use-pin && npm run typecheck && npm run build:electron && vite build",
    "check:computer-use-pin": "node scripts/check-pi-computer-use-pin.mjs",
    "build:mac-icon": "scripts/build-mac-icon.sh",
    "package:mac": "scripts/clean-mac-release.sh && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never && scripts/clean-mac-release.sh --app-only",
    "package:mac:dir": "scripts/clean-mac-release.sh && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --dir --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@injaneity/pi-computer-use": "git+https://github.com/No-Github/pi-computer-use.git#8dd8fde2edb7d2bc115d2beaedf1a331710e9223",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fflate": "^0.8.3",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@tiptap/extension-details": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-task-item": "^3.30.5",
    "@tiptap/extension-task-list": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "electron": "42.10.1",
    "electron-builder": "^26.15.3",
    "linkifyjs": "^4.3.3",
    "lucide-react": "^0.468.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "0.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^8.2.1",
    "wait-on": "^8.0.0"
  }
}
